{
  "name": "@tokens-as-parameters/root",
  "version": "0.1.0",
  "private": true,
  "description": "Inference-time token optimization plugins and formal-verification research bundles for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceLoveLee000/tokens-as-parameters.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && tsx --test 'tests/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run --workspaces",
    "pack:local": "npm pack --workspaces"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "22.20.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
